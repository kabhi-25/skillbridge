# ==============================================================================
# SkillBridge — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# SkillBridge operates as a privacy-preserving, local-first client workspace.
# All calculations, data persistence, and crypto hashing run in-browser.
# ==============================================================================

# Application port for local preview and development servers
PORT=8080

# Optional demo student credentials (overrides built-in defaults)
VITE_DEMO_USER_EMAIL=alex.chen@student.edu
VITE_DEMO_USER_PASSWORD=Password123!

# Application branding / metadata
VITE_APP_TITLE="SkillBridge — Student Skill-to-Role Matching"
VITE_APP_DESCRIPTION="Interactive engineering skill gap evaluator and roadmap generator"
