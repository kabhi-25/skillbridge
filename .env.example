# ==============================================================================
# SkillBridge — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# SkillBridge operates as a client-side prototype.
# All calculations and data persistence run in-browser.
# NOTE: VITE_ variables are bundled and exposed to the browser client.
# Never store real credentials, secrets, or passwords in .env files.
# ==============================================================================

# Application port for local preview and development servers
PORT=8080

# Application branding / metadata
VITE_APP_TITLE="SkillBridge — Student Skill-to-Role Matching"
VITE_APP_DESCRIPTION="Interactive engineering skill gap evaluator and roadmap generator"
